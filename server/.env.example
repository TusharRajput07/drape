NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Neon pooled connection (used by the app)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/wardrobe?sslmode=verify-full
# Neon direct connection (used by Prisma migrations)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/wardrobe?sslmode=verify-full

# At least 64 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-64-random-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# lax | none (none when client and server are on different domains)
COOKIE_SAMESITE=lax
# Proxies in front of the server: loopback (default; the dev tunnel) or a hop count like 1 (set with hosting)
TRUST_PROXY=loopback

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
