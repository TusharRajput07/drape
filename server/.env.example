# development on the laptop; production on the host (then the server also serves the built app and
# runs the two clean-up jobs, see DEPLOY.md)
NODE_ENV=development
PORT=4000
# Where the app is opened. Development: the Vite dev server. Production: the app's own address,
# e.g. https://drape.onrender.com (no trailing slash)
CLIENT_URL=http://localhost:5173

# Neon pooled connection (used by the app)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/wardrobe?sslmode=verify-full
# Neon direct connection (used by Prisma migrations)
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/wardrobe?sslmode=verify-full

# At least 64 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-64-random-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# lax | none. lax whenever the app and the API share one address (development, and production where this
# server serves the app). none only if the app is ever hosted on a different domain from the API.
COOKIE_SAMESITE=lax
# Proxies in front of the server whose X-Forwarded-For is believed (for the login rate limit):
# loopback (default; the dev tunnel, or a proxy on the same machine) or a hop count like 1 behind a
# host's load balancer (Render: 1). Never true.
TRUST_PROXY=loopback

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
